{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      ".codesleuth/reports/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git branch --show-current*": "allow",
      "git merge-base*": "allow",
      "git cat-file*": "allow",
      "git hash-object*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      ".opencode/bin/codesleuth-reports sync*": "allow",
      "./.opencode/bin/codesleuth-reports sync*": "allow",
      ".opencode/bin/codesleuth-reports publish*": "allow",
      "./.opencode/bin/codesleuth-reports publish*": "allow",
      ".opencode/bin/codesleuth-reports.ps1 sync*": "allow",
      ".opencode/bin/codesleuth-reports.ps1 publish*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    },
    "codesleuth_context_*": "deny",
    "repo_context_provider_*": "deny",
    "external_directory": "ask",
    "websearch": "ask",
    "webfetch": "ask",
    "lsp": "allow",
    "skill": {
      "*": "ask",
      "exact-target-identity": "allow",
      "repository-deep-review": "allow",
      "feature-porting-discipline": "allow",
      "protected-capability-registry": "allow",
      "contract-triangulation": "allow",
      "forbidden-regression-ledger": "allow",
      "dependency-impact-closure": "allow",
      "target-ownership-map": "allow",
      "acceptance-matrix-design": "allow",
      "documentation-draft": "allow",
      "codesleuth-reports": "allow",
      "eha-candidate-selection": "allow",
      "eha-campaign-evidence": "allow",
      "eha-repair-protocol": "allow",
      "findings-ledger-update": "allow",
      "report-bug-closure": "allow"
    },
    "question": "allow",
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "permission": {
        "codesleuth_context_get": "allow",
        "repo_context_provider_status": "allow",
        "repo_context_provider_extract": "allow"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".opencode/cache/**",
      ".opencode/logs/**",
      ".opencode/state/**",
      ".codesleuth/reports/**",
      "node_modules/**",
      "target/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "__pycache__/**"
    ]
  },
  "plugin": [
    [
      "opencode-keepalive@0.1.0",
      {
        "intervalMs": 10000,
        "stallMs": 480000,
        "childStallAction": "abort-resume-parent",
        "maxStallRecoveries": 2,
        "abortWaitMs": 30000,
        "toolStallMsByTool": {
          "glob": 90000,
          "grep": 90000,
          "read": 120000,
          "webfetch": 180000,
          "websearch": 180000
        },
        "bashQuickStallMs": 90000,
        "output": "file"
      }
    ]
  ]
}
