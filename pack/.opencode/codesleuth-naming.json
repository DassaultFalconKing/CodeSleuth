{
  "schemaVersion": 1,
  "product": {
    "displayName": "CodeSleuth",
    "slug": "codesleuth"
  },
  "canonical": {
    "state": {
      "metadata": "codesleuth.json",
      "settings": "codesleuth-user.json"
    },
    "entrypoints": {
      "console": "bin/codesleuth",
      "consolePowerShell": "bin/codesleuth.ps1",
      "project": "bin/codesleuth-project",
      "projectPowerShell": "bin/codesleuth-project.ps1",
      "update": "bin/codesleuth-update",
      "updatePowerShell": "bin/codesleuth-update.ps1",
      "verify": "bin/codesleuth-verify.py"
    },
    "python": {
      "project": "bin/codesleuth_project.py",
      "update": "bin/codesleuth_update.py",
      "tui": "bin/codesleuth_tui.py",
      "tuiBase": "bin/codesleuth_tui_base.py",
      "tuiCore": "bin/codesleuth_tui_core.py",
      "tuiBootstrap": "bin/codesleuth_tui_bootstrap.py"
    },
    "environment": {
      "distributionRoot": "CODESLEUTH_DISTRIBUTION_ROOT",
      "targetRoot": "CODESLEUTH_TARGET_ROOT"
    },
    "cliOptions": {
      "adoptExisting": "--adopt-existing-codesleuth",
      "forceManagedFiles": "--force-codesleuth-files"
    },
    "statusMessages": {
      "current": "CODESLEUTH CURRENT",
      "updateAvailable": "CODESLEUTH UPDATE AVAILABLE",
      "updateApplied": "CODESLEUTH UPDATE APPLIED",
      "verifyPass": "CODESLEUTH VERIFY PASS"
    },
    "temporaryPrefix": "codesleuth-update-",
    "invocation": {
      "namespace": "codesleuth",
      "commandNamespace": "codesleuth/",
      "operations": {
        "bug-hunt": {
          "path": "/codesleuth/bug-hunt",
          "compatibilityAliases": ["/bug-hunt"],
          "playbookId": "bug-hunter"
        },
        "eha-repair": {
          "path": "/codesleuth/eha/repair",
          "compatibilityAliases": ["/eha-repair"],
          "playbookId": "eha-repair"
        },
        "eha-status": {
          "path": "/codesleuth/eha/status",
          "compatibilityAliases": ["/eha-status"]
        },
        "eha-test": {
          "path": "/codesleuth/eha/test",
          "compatibilityAliases": ["/eha-test"],
          "playbookId": "eha-sib-acceptance"
        },
        "playbook": {
          "path": "/codesleuth/playbook",
          "compatibilityAliases": ["/playbook"]
        },
        "playbooks": {
          "path": "/codesleuth/playbooks",
          "compatibilityAliases": ["/playbooks"]
        },
        "continue": {
          "path": "/codesleuth/continue",
          "compatibilityAliases": ["/repo-continue"],
          "playbookId": "repository-development-continuation"
        },
        "contract-adjudicate": {
          "path": "/codesleuth/contracts/adjudicate",
          "compatibilityAliases": ["/repo-contract-adjudicate"]
        },
        "contract-bootstrap": {
          "path": "/codesleuth/contracts/bootstrap",
          "compatibilityAliases": ["/repo-contract-bootstrap"],
          "playbookId": "repository-contract-bootstrap"
        },
        "contracts": {
          "path": "/codesleuth/contracts",
          "compatibilityAliases": ["/repo-contracts"],
          "playbookId": "protected-capability-assessment"
        },
        "docs": {
          "path": "/codesleuth/docs",
          "compatibilityAliases": ["/repo-docs"],
          "playbookId": "repository-documentation"
        },
        "map": {
          "path": "/codesleuth/map",
          "compatibilityAliases": ["/repo-map"],
          "playbookId": "repository-map"
        },
        "port": {
          "path": "/codesleuth/port",
          "compatibilityAliases": ["/repo-port"],
          "playbookId": "feature-port"
        },
        "profile": {
          "path": "/codesleuth/profile",
          "compatibilityAliases": ["/repo-profile"]
        },
        "prompts": {
          "path": "/codesleuth/prompts",
          "compatibilityAliases": ["/repo-prompts"]
        },
        "report": {
          "path": "/codesleuth/report",
          "compatibilityAliases": ["/repo-report"]
        },
        "review-resume": {
          "path": "/codesleuth/review/resume",
          "compatibilityAliases": ["/repo-review-resume"]
        },
        "review": {
          "path": "/codesleuth/review",
          "compatibilityAliases": ["/repo-review"],
          "playbookId": "repository-deep-review"
        }
      }
    }
  },
  "legacy": {
    "state": {
      "metadata": "review-pack.json",
      "settings": "review-pack-user.json"
    },
    "entrypoints": {
      "rootConsole": "review-pack",
      "rootConsolePowerShell": "review-pack.ps1",
      "console": "bin/review-pack",
      "consolePowerShell": "bin/review-pack.ps1",
      "update": "bin/review-pack-update",
      "updatePowerShell": "bin/review-pack-update.ps1",
      "verify": "bin/review-pack-smoke.py"
    },
    "python": {
      "update": "bin/review-pack-update.py",
      "tuiBase": "bin/review_pack_tui.py",
      "tuiCore": "bin/review_pack_tui_core.py",
      "tuiBootstrap": "bin/review_pack_tui_bootstrap.py"
    },
    "environment": {
      "distributionRoot": "REVIEW_PACK_DISTRIBUTION_ROOT",
      "targetRoot": "REVIEW_PACK_TARGET_ROOT"
    },
    "cliOptions": {
      "adoptExisting": "--adopt-existing-pack",
      "forceManagedFiles": "--force-pack-files"
    },
    "temporaryPrefix": "opencode-review-pack-update-"
  },
  "migration": {
    "release040PersistentState": "legacy",
    "freshInstallMaterializesLegacy": false,
    "legacyArgumentsAreHidden": true,
    "failOnConflictingPersistentState": true,
    "bridgeEntrypoints": [
      "bin/review-pack-smoke.py",
      "bin/review_pack_tui_bootstrap.py"
    ],
    "bridgeManaged": false,
    "removeBridgeAfterCanonicalBootstrap": true
  }
}
