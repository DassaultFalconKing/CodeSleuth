{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "csBg": "#081018",
    "csPanel": "#0E1822",
    "csElement": "#13212D",
    "csBorder": "#29404F",
    "csBorderActive": "#3E718A",
    "csPrimary": "#63D5F4",
    "csSecondary": "#8AA7B8",
    "csAccent": "#A7E3F2",
    "csText": "#D8E3EB",
    "csMuted": "#71879A",
    "csSuccess": "#62D394",
    "csWarning": "#F0C36A",
    "csError": "#F07178",
    "csDiffAddBg": "#10271F",
    "csDiffRemoveBg": "#2A171B",
    "csLightBg": "#F5F8FA",
    "csLightPanel": "#EAF0F4",
    "csLightElement": "#DFE8EE",
    "csLightBorder": "#BAC9D3",
    "csLightBorderActive": "#4C839A",
    "csLightPrimary": "#087EA4",
    "csLightSecondary": "#4C6575",
    "csLightAccent": "#176F85",
    "csLightText": "#16202A",
    "csLightMuted": "#607482",
    "csLightSuccess": "#197A4A",
    "csLightWarning": "#9B6411",
    "csLightError": "#B8323E",
    "csLightDiffAddBg": "#DDF3E7",
    "csLightDiffRemoveBg": "#F8DFE2"
  },
  "theme": {
    "primary": {"dark": "csPrimary", "light": "csLightPrimary"},
    "secondary": {"dark": "csSecondary", "light": "csLightSecondary"},
    "accent": {"dark": "csAccent", "light": "csLightAccent"},
    "error": {"dark": "csError", "light": "csLightError"},
    "warning": {"dark": "csWarning", "light": "csLightWarning"},
    "success": {"dark": "csSuccess", "light": "csLightSuccess"},
    "info": {"dark": "csPrimary", "light": "csLightPrimary"},
    "text": {"dark": "csText", "light": "csLightText"},
    "textMuted": {"dark": "csMuted", "light": "csLightMuted"},
    "background": {"dark": "csBg", "light": "csLightBg"},
    "backgroundPanel": {"dark": "csPanel", "light": "csLightPanel"},
    "backgroundElement": {"dark": "csElement", "light": "csLightElement"},
    "border": {"dark": "csBorder", "light": "csLightBorder"},
    "borderActive": {"dark": "csBorderActive", "light": "csLightBorderActive"},
    "borderSubtle": {"dark": "csBorder", "light": "csLightBorder"},
    "diffAdded": {"dark": "csSuccess", "light": "csLightSuccess"},
    "diffRemoved": {"dark": "csError", "light": "csLightError"},
    "diffContext": {"dark": "csMuted", "light": "csLightMuted"},
    "diffHunkHeader": {"dark": "csSecondary", "light": "csLightSecondary"},
    "diffHighlightAdded": {"dark": "csSuccess", "light": "csLightSuccess"},
    "diffHighlightRemoved": {"dark": "csError", "light": "csLightError"},
    "diffAddedBg": {"dark": "csDiffAddBg", "light": "csLightDiffAddBg"},
    "diffRemovedBg": {"dark": "csDiffRemoveBg", "light": "csLightDiffRemoveBg"},
    "diffContextBg": {"dark": "csPanel", "light": "csLightPanel"},
    "diffLineNumber": {"dark": "csMuted", "light": "csLightMuted"},
    "diffAddedLineNumberBg": {"dark": "csDiffAddBg", "light": "csLightDiffAddBg"},
    "diffRemovedLineNumberBg": {"dark": "csDiffRemoveBg", "light": "csLightDiffRemoveBg"},
    "markdownText": {"dark": "csText", "light": "csLightText"},
    "markdownHeading": {"dark": "csPrimary", "light": "csLightPrimary"},
    "markdownLink": {"dark": "csSecondary", "light": "csLightSecondary"},
    "markdownLinkText": {"dark": "csAccent", "light": "csLightAccent"},
    "markdownCode": {"dark": "csSuccess", "light": "csLightSuccess"},
    "markdownBlockQuote": {"dark": "csMuted", "light": "csLightMuted"},
    "markdownEmph": {"dark": "csWarning", "light": "csLightWarning"},
    "markdownStrong": {"dark": "csAccent", "light": "csLightAccent"},
    "markdownHorizontalRule": {"dark": "csBorderActive", "light": "csLightBorderActive"},
    "markdownListItem": {"dark": "csPrimary", "light": "csLightPrimary"},
    "markdownListEnumeration": {"dark": "csAccent", "light": "csLightAccent"},
    "markdownImage": {"dark": "csSecondary", "light": "csLightSecondary"},
    "markdownImageText": {"dark": "csAccent", "light": "csLightAccent"},
    "markdownCodeBlock": {"dark": "csText", "light": "csLightText"},
    "syntaxComment": {"dark": "csMuted", "light": "csLightMuted"},
    "syntaxKeyword": {"dark": "csSecondary", "light": "csLightSecondary"},
    "syntaxFunction": {"dark": "csPrimary", "light": "csLightPrimary"},
    "syntaxVariable": {"dark": "csAccent", "light": "csLightAccent"},
    "syntaxString": {"dark": "csSuccess", "light": "csLightSuccess"},
    "syntaxNumber": {"dark": "csWarning", "light": "csLightWarning"},
    "syntaxType": {"dark": "csAccent", "light": "csLightAccent"},
    "syntaxOperator": {"dark": "csSecondary", "light": "csLightSecondary"},
    "syntaxPunctuation": {"dark": "csText", "light": "csLightText"}
  }
}
