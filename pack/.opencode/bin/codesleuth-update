#!/usr/bin/env sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "CodeSleuth updater requires Python 3" >&2
  exit 127
fi

exec "$PYTHON" "$HERE/codesleuth_update.py" "$@"
