        "tests/context_graph_smoke.ts",
        "docs/CONTEXT-GRAPH-DISCIPLINE.md"
      ],
      "depends_on": [
        "codesleuth.host-execution-authority"
      ],
      "forbidden_regressions": [
        {
          "id": "FR-GRAPH-001",
          "sib_origin": "SIB1",
          "must_not": "Context graph or Mermaid output becomes an unbounded replacement for exact repository evidence or is treated as sufficient material-finding evidence by itself.",
          "proof": [
            "tests/context_graph_smoke.ts",
            "docs/CONTEXT-GRAPH-DISCIPLINE.md"
          ]
        },
        {
          "id": "FR-GRAPH-002",
          "sib_origin": "SIB2",
          "must_not": "A generated graph silently diverges from its repository/review-state provenance while remaining presented as verified source structure.",
          "proof": [
            "tests/context_graph_smoke.ts"
          ]
        }
      ]
    },
    {
      "id": "codesleuth.durable-review-state",
      "capability_class": "persistent-review-state",
      "status": "protected",
      "introduced": "pre-registry",
      "protected_at": {
        "sib_level": "SIB2",
        "sha": "c5e41a73b84e65645dec5d0a4032b19928291193",
        "evidence": "docs/STABLE-INTEGRATION-BASELINE.md"
      },
      "public_contract": [
        "Durable review state survives model-context compaction and records evidence identity independently of chat history.",
        "Durable analytical state is review evidence/supporting state, not execution authority for the host."
      ],
      "contract_fingerprint": {
        "state_role": "durable-review-evidence",
        "execution_authority": false
      },
      "code_evidence": [
        "pack/.opencode/tools/review_state.ts"
