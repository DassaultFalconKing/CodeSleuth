      ],
      "affected_paths": [
        "pack/.opencode/tools/review_state.ts",
        "tests/review_state_smoke.ts",
        "pack/.opencode/plugins/review-compaction.ts"
      ],
      "depends_on": [
        "codesleuth.host-execution-authority"
      ],
      "forbidden_regressions": [
        {
          "id": "FR-STATE-001",
          "sib_origin": "SIB1",
          "must_not": "Durable review state becomes merely conversational or loses the evidence identity needed to rehydrate a finding after compaction.",
          "proof": [
            "tests/review_state_smoke.ts"
          ]
        },
        {
          "id": "FR-STATE-002",
          "sib_origin": "SIB0",
          "must_not": "Durable review state becomes an independent controller or execution-state authority competing with the host.",
          "proof": [
            "docs/CODESLEUTH-PRODUCT-CONTRACT.md"
          ]
        }
      ]
    },
    {
      "id": "codesleuth.update-restart",
      "capability_class": "lifecycle-update-management",
      "status": "implemented",
      "introduced": "post-registry-baseline-lineage",
      "protected_at": null,
      "public_contract": [
        "CodeSleuth can check/fetch/apply an allowed update and perform the documented restart/reload path without falsely reporting a transition that did not occur."
      ],
      "contract_fingerprint": {
        "update_requires_post_update_verify": true,
        "restart_is_part_of_lifecycle": true
      },
      "code_evidence": [
        "pack/.opencode/bin/review-pack-update.py",
        "pack/.opencode/bin/codesleuth_tui_runtime.py"
      ],
      "doc_evidence": [
        "docs/SELF-UPDATE.md",
        "docs/PROJECT-LIFECYCLE.md"
      ],
      "test_evidence": [
