{
  "schema_version": 1,
  "registry": "codesleuth-protected-capabilities",
  "authority": "docs/PROTECTED-CAPABILITY-CONTRACTS.md",
  "bootstrap_note": "This initial registry captures high-confidence contracts visible in current code, documentation and tests. Post-baseline capabilities remain implemented until exact SIB1/SIB2 promotion evidence is attached; do not upgrade status by inference.",
  "query_policy": {
    "small_registry": "grep_or_ripgrep_then_paged_exact_read",
    "large_registry": "bm25_then_optional_embeddings_then_optional_reranker_then_exact_manifest_read",
    "semantic_retrieval_is_authority": false,
    "allow_new_search_runtime": false
  },
  "status_values": [
    "experimental",
    "implemented",
    "sib1_accepted",
    "sib2_integrated",
    "protected",
    "deprecated",
    "removed"
  ],
  "contracts": [
    {
      "id": "codesleuth.host-execution-authority",
      "capability_class": "controller-tool-execution-boundary",
      "status": "protected",
      "introduced": "pre-registry",
      "protected_at": {
        "sib_level": "SIB2",
        "sha": "c5e41a73b84e65645dec5d0a4032b19928291193",
        "evidence": "docs/STABLE-INTEGRATION-BASELINE.md"
      },
      "public_contract": [
        "The active host owns the model, primary controller, session, tool routing and execution.",
        "CodeSleuth may configure, expose, package and harden host-native capabilities but must not create a second primary agent runtime or controller."
      ],
      "contract_fingerprint": {
        "execution_owner": "host",
        "codesleuth_role": "discipline-and-control-surface"
      },
      "code_evidence": [
        "pack/.opencode/commands/repo-review.md",
        "pack/.opencode/opencode.json"
      ],
      "doc_evidence": [
        "docs/CODESLEUTH-PRODUCT-CONTRACT.md",
        "AGENTS.md"
      ],
      "test_evidence": [
        "tests/test_docs_contract.py",
        "tests/test_agents_pointer.py"
      ],
      "affected_paths": [
        "pack/.opencode/agents/**",
        "pack/.opencode/commands/**",
        "pack/.opencode/opencode.json",
        "pack/.opencode/plugins/**",
        "pack/.opencode/tools/**",
        "docs/CODESLEUTH-PRODUCT-CONTRACT.md"
      ],
      "depends_on": [],
      "forbidden_regressions": [
        {
          "id": "FR-HOST-001",
          "sib_origin": "SIB0",
          "must_not": "CodeSleuth becomes or installs a second primary controller, supervisor, agent loop, model runtime, or general-purpose tool router alongside the active host.",
          "proof": [
            "docs/CODESLEUTH-PRODUCT-CONTRACT.md",
            "tests/test_docs_contract.py"
          ]
        },
        {
          "id": "FR-HOST-002",
          "sib_origin": "SIB0",
          "must_not": "A CodeSleuth-specific state format becomes a second source of truth for host model, controller, or tool execution.",
          "proof": [
            "docs/CODESLEUTH-PRODUCT-CONTRACT.md"
          ]
        }
      ]
    },
    {
      "id": "codesleuth.context-graph-evidence-boundary",
