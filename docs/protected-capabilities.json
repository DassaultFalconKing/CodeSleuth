        },
        {
          "id": "FR-UPDATE-002",
          "sib_origin": "SIB1",
          "must_not": "The documented update action degenerates into a no-op or unreachable path while remaining advertised as available.",
          "proof": [
            "tests/test_update_restart.py"
          ]
        }
      ]
    },
    {
