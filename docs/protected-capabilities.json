      "forbidden_regressions": [
        {
          "id": "FR-UPDATE-001",
          "sib_origin": "SIB2",
          "must_not": "Update is reported successful while restart/reload continues to execute the previous source or otherwise fails to complete the documented transition.",
          "proof": [
            "tests/test_update_restart.py"
